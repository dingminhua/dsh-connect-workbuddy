{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/client",
    "tests/pool-render-helpers.tsx",
    "tests/pool-render.spec.tsx",
    "tests/pool-card-render.spec.tsx",
    "tests/probe-age.spec.tsx",
    "tests/remaining.spec.tsx",
    "tests/off-thinking-card.spec.tsx",
    "tests/context-tiers.spec.tsx",
    "tests/card-credits-switch.spec.tsx",
    "tests/composer-credits-gate.spec.ts",
    "tests/composer-credits-render.spec.tsx",
    "tests/client-runtime-imports.spec.ts"
  ]
}
